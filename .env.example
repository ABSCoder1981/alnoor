# Copy to .env (never commit .env). Values here are placeholders only.

# --- Local PostgreSQL (docker-compose.yml) ---
POSTGRES_DB=alnoor_dev
POSTGRES_USER=alnoor
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# --- Backend API (ASP.NET Core reads these as configuration; "__" = section separator) ---
# For local development prefer `dotnet user-secrets` (see README) instead of exporting these.
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Port=5432;Database=alnoor_dev;Username=alnoor;Password=change-me-local-only
Cors__AllowedOrigins=http://localhost:5173

# Added in later phases (not used in Phase 1):
# Jwt__SigningKey=          # Phase 3: at least 32 random bytes, base64
# Jwt__Issuer=
# Jwt__Audience=
# LiveKit__Url=             # Phase 2
# LiveKit__ApiKey=
# LiveKit__ApiSecret=
